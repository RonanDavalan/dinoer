# Config machine — ne jamais versionner
dinoer.conf

# Profils opérateur nominaux (v1.3) — seul operateur.exemple.yaml est versionné
dinoer.conf.d/operateur.*.yaml
!dinoer.conf.d/operateur.exemple.yaml

# Références structurelles générées localement (--sauver-verifier-reference, rpa.py)
references/
scenarios/interoperabilite/ref_*.json

# Captures temporaires
/tmp/dinoer/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/

# Éditeurs
.vscode/
.idea/
*.swp
*~

# Debian packaging — artefacts de build (dpkg-buildpackage), jamais commités.
# La recette elle-même (debian/) vit dans le tampon (~/git/Dinoer/debian/),
# jamais ici — construire-paquet.sh l'y copie le temps du build seulement.
debian/.debhelper/
debian/dinoer/
debian/debhelper-build-stamp
debian/dinoer.substvars
debian/files
debian/*.log

# Pages de manuel générées au build par pandoc — la source versionnée est
# docs/dinoer.1.md (et ses traductions docs/<langue>/dinoer.1.md), jamais le
# roff produit.
debian/dinoer.1
debian/dinoer-shot.1
debian/dinoer-rpa.1
debian/dinoer-campaign.1
debian/dinoer-monter-secrets.1
debian/dinoer-demonter-secrets.1
debian/dinoer-monitor-verifier.1
debian/dinoer.??.1
debian/dinoer-*.??.1
